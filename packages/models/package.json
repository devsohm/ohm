{
  "name": "@ohm/models",
  "version": "0.1.1",
  "private": true,
  "description": "Provider-neutral model, streaming, authentication, and image primitives for ohm",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/compat.js",
    "./dist/providers/images/register-builtins.js"
  ],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./compat": { "types": "./dist/compat.d.ts", "import": "./dist/compat.js" },
    "./providers/create-builtin": null,
    "./providers/*": { "types": "./dist/providers/*.d.ts", "import": "./dist/providers/*.js" },
    "./api/internal/*": null,
    "./api/*": { "types": "./dist/api/*.d.ts", "import": "./dist/api/*.js" },
    "./oauth": { "types": "./dist/oauth.d.ts", "import": "./dist/oauth.js" },
    "./bedrock-provider": { "types": "./dist/bedrock-provider.d.ts", "import": "./dist/bedrock-provider.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "assets", "README.md", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devsohm/ohm.git",
    "directory": "packages/models"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "check:model-data": "node scripts/check-model-data.mjs",
    "build": "npm run build:offline",
    "build:offline": "npm run clean && npm run check:model-data && tsc -p tsconfig.build.json && node scripts/copy-model-data.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.public-types.json && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run check:model-data && npm run typecheck && npm test"
  },
  "engines": { "node": ">=26.7.0" },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1116.0",
    "partial-json": "0.1.7",
    "typebox": "1.3.17"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
